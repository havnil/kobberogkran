---
// Dark footer: logo and one sentence, contact, address, and a bottom line in monospace.
import Plassholder from './Plassholder.astro';
import WhatsAppKnapp from './WhatsAppKnapp.astro';
import type { Locale } from '../i18n/locales';
import { navPath } from '../i18n/nav';
import { ui } from '../i18n/ui';
import { getFirma } from '../lib/firma';
import { getTekster } from '../lib/tekster';
import { telHref } from '../lib/telefon';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const [firma, tekster] = await Promise.all([getFirma(), getTekster(locale)]);
const felles = tekster.sider.felles;
const ar = new Date().getFullYear();
---

<footer class="bunn band">
  <div class="ramme">
    <div class="bunn-kolonner">
      <div>
        <img class="bunn-logo" src="/logo/kobber-og-kran-a-paa-brun.svg" alt="" width="190" height="64" />
        <p>{felles.bunntekst}</p>
      </div>
      <div>
        <h2 class="bunn-tittel">{felles.kontaktTittel}</h2>
        <ul class="bunn-liste">
          <li><a href={telHref(firma.telefon.verdi)}><Plassholder verdi={firma.telefon} locale={locale} /></a></li>
          <li>
            {
              firma.epost.plassholder ? (
                <Plassholder verdi={firma.epost} locale={locale} />
              ) : (
                <a href={`mailto:${firma.epost.verdi}`}>{firma.epost.verdi}</a>
              )
            }
          </li>
          <li><WhatsAppKnapp locale={locale}>{t.whatsapp}</WhatsAppKnapp></li>
        </ul>
      </div>
      <div>
        <h2 class="bunn-tittel">{felles.adresseTittel}</h2>
        <address>
          <strong>{firma.juridiskNavn}</strong><br />
          <Plassholder verdi={firma.adresse} locale={locale} />
        </address>
      </div>
    </div>
    <p class="bunnlinje">
      <span>© {ar} {firma.juridiskNavn}</span>
      <span>{t.orgnr} <Plassholder verdi={firma.orgnr} locale={locale} /> MVA</span>
      <a href={navPath(locale, 'om')}>{t.nav.om}</a>
      <a href={navPath(locale, 'kontakt')}>{t.nav.kontakt}</a>
      <a href={navPath(locale, 'personvern')}>{t.personvern}</a>
      <a href={navPath(locale, 'vilkar')}>{t.vilkar}</a>
    </p>
  </div>
</footer>

<style>
  .bunn {
    padding-block: 3.5rem 2rem;
  }

  .bunn-kolonner {
    display: grid;
    gap: var(--space-4);
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgb(247 242 236 / 0.2);
  }

  .bunn-logo {
    display: block;
    height: 3.5rem;
    width: auto;
    margin-bottom: var(--space-3);
  }

  p {
    margin: 0;
    max-width: 34rem;
  }

  .bunn-tittel {
    margin: 0 0 var(--space-3);
    color: var(--color-orange-light);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .bunn-liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }

  address {
    font-style: normal;
  }

  a {
    color: var(--color-cream);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-orange-light);
    text-decoration: underline;
  }

  .bunnlinje {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0;
    max-width: none;
    padding-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .bunnlinje > :not(:last-child)::after {
    content: '·';
    margin-inline: 0.6rem;
    color: var(--color-orange-light);
  }

  @media (min-width: 1000px) {
    .bunn-kolonner {
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: var(--space-5);
    }
  }
</style>
