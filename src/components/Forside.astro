---
// The front page, section for section as in docs/research/2026-11-13-kimkran-element-for-element.md.
// All copy comes from `tekster/<locale>.json` (`forside`); prices and places from `firma`.
import Band from './Band.astro';
import Faktakort from './Faktakort.astro';
import Hero from './Hero.astro';
import OmraderForside from './OmraderForside.astro';
import Servicebil from './Servicebil.astro';
import Skjemaseksjon from './Skjemaseksjon.astro';
import Steg from './Steg.astro';
import TankFremhevet from './TankFremhevet.astro';
import Tanksjekk from './Tanksjekk.astro';
import TjenesteKort from './TjenesteKort.astro';
import type { Locale } from '../i18n/locales';
import { getServices, serviceSlugOf, servicePath } from '../i18n/services';
import { getFirma } from '../lib/firma';
import { getOmtale, synligeOmtale, visEksempler } from '../lib/omtale';
import { launchVerdi } from '../lib/lansering';
import { aktivSesong } from '../lib/priser';
import { getTekster } from '../lib/tekster';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const [firma, tekster, tjenester, omtale] = await Promise.all([getFirma(), getTekster(locale), getServices(locale), getOmtale()]);
// `LAUNCH` is read at build time via import.meta.env (see src/lib/lansering.ts).
const synlig = synligeOmtale(omtale, visEksempler(import.meta.env.PROD, launchVerdi()));
const f = tekster.forside;
const hrefFor = (key: string) => {
  const e = tjenester.find((s) => s.data.translationKey === key);
  return e ? servicePath(locale, serviceSlugOf(e)) : undefined;
};
const tankHref = hrefFor('varmtvannstank') ?? '#skjema';
const hytteHref = hrefFor('hytte');
const sesongTekst = f.hero.sesongmerke[aktivSesong(new Date())];
const sesong = hytteHref ? { tekst: sesongTekst.tekst, href: sesongTekst.anker ? `${hytteHref}#${sesongTekst.anker}` : hytteHref } : undefined;
// The accent line is the end of the title; if the text no longer ends with it, the whole title stays plain.
const delt = f.hero.tittelAksent !== '' && f.hero.tittel.endsWith(f.hero.tittelAksent);
const tittel = delt ? f.hero.tittel.slice(0, -f.hero.tittelAksent.length).trim() : f.hero.tittel;
const nk = f.nokkeltall;
const p = firma.priser;
const ruter = f.tjenester.ruter.flatMap((r) => {
  const href = hrefFor(r.tjeneste);
  return href ? [{ ...r, href: r.anker ? `${href}#${r.anker}` : href }] : [];
});
---

<Hero locale={locale} firma={firma} tittel={tittel} aksent={delt ? f.hero.tittelAksent : undefined} ingress={f.hero.ingress} eyebrow={f.hero.stedslinje} sesong={sesong} skjemaHref="#skjema" bilde={{ src: '/images/uploads/illustrasjon-hero.svg', width: 1600, height: 1000, plassholder: true }}>
  <Faktakort
    slot="kort"
    locale={locale}
    venstre={nk.eyebrow}
    hoyre={nk.merke}
    celler={[
      { etikett: nk.timepris, verdi: p.timepris, enhet: 'kr', pris: true },
      { etikett: nk.tank, verdi: p.varmtvannstankArbeid, enhet: 'kr', pris: true },
      { etikett: nk.servicebil, verdi: p.servicebil, enhet: 'kr', pris: true },
      { etikett: nk.kjoretid, verdi: firma.omrade.maksKjoretidMin, enhet: nk.kjoretidEnhet },
    ]}
    bunn={nk.prisForStart}
  />
</Hero>

<section class="seksjon" id="tjenester" aria-labelledby="tjenester-tittel">
  <div class="ramme">
    <div class="hode">
      <div>
        <p class="eyebrow">{f.tjenester.eyebrow.replace('{antall}', String(ruter.length))}</p>
        <h2 id="tjenester-tittel" class="display">{f.tjenester.ruterTittel}</h2>
      </div>
      <p class="hode-ingress">{f.tjenester.ingress}</p>
    </div>
    <ol class="ruter">
      {ruter.map((r, i) => <TjenesteKort href={r.href} nummer={i + 1} tittel={r.tittel} tekst={r.tekst} seMer={f.tjenester.seMer} />)}
    </ol>
  </div>
</section>

<Servicebil locale={locale} tekst={f.bil} />
<TankFremhevet locale={locale} tekst={f.varmtvann} priser={firma.priser} tankHref={tankHref} />
<Tanksjekk tekst={f.tanksjekk} tankHref={tankHref} />
<Band locale={locale} tekst={f.band} />
<OmraderForside locale={locale} tekst={f.omrader} omtaleTittel={f.omEirik.anmeldelserTittel} omrade={firma.omrade} omtale={synlig} />
<Steg tekst={f.steg} />
<Skjemaseksjon locale={locale} tekst={f.skjema} lekker />
