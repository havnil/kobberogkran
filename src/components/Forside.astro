---
// The front page. Sections follow the spec order; all copy comes from `tekster/<locale>.json` (`forside`).
import Hero from './Hero.astro';
import LekkerNaa from './LekkerNaa.astro';
import Omrader from './Omrader.astro';
import OmEirik from './OmEirik.astro';
import PrisBlokk from './PrisBlokk.astro';
import Steg from './Steg.astro';
import TjenesteKort from './TjenesteKort.astro';
import VarmtvannstankBlokk from './VarmtvannstankBlokk.astro';
import type { Locale } from '../i18n/locales';
import { getServices, serviceSlugOf, servicePath } from '../i18n/services';
import { getFirma } from '../lib/firma';
import { getOmtale, synligeOmtale, visEksempler } from '../lib/omtale';
import { getTekster } from '../lib/tekster';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const [firma, tekster, tjenester, omtale] = await Promise.all([getFirma(), getTekster(locale), getServices(locale), getOmtale()]);
// `process.env.LAUNCH` is read at build time (the page is static); see src/lib/omtale.ts.
const synlig = synligeOmtale(omtale, visEksempler(import.meta.env.PROD, process.env.LAUNCH));
const f = tekster.forside;
---

<Hero locale={locale} hero={f.hero} firma={firma} />

<section class="seksjon" aria-labelledby="tjenester-tittel">
  <h2 id="tjenester-tittel">{f.tjenester.tittel}</h2>
  <ol class="kort-liste">
    {tjenester.map((e) => <TjenesteKort href={servicePath(locale, serviceSlugOf(e))} tjeneste={e.data} />)}
  </ol>
</section>

<LekkerNaa locale={locale} tekst={tekster.lekkerNaa} firma={firma} />
<VarmtvannstankBlokk locale={locale} tekst={f.varmtvann} priser={firma.priser} />
<PrisBlokk locale={locale} tekst={f.priser} priser={firma.priser} />
<Steg tekst={f.steg} />
<OmEirik tekst={f.omEirik} omtale={synlig} />
<Omrader tekst={f.omrader} omrade={firma.omrade} />

<!-- Placeholder for the request form; it is built in a later task. -->
<section class="seksjon" id="skjema" aria-labelledby="skjema-tittel">
  <h2 id="skjema-tittel">{f.skjema.tittel}</h2>
  <p>{f.skjema.merknad}</p>
</section>

<style>
  h2 {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
  }
  .kort-liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  @media (min-width: 720px) {
    .kort-liste {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .kort-liste {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
