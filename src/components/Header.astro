---
import LanguageSwitcher from './LanguageSwitcher.astro';
import WhatsAppKnapp from './WhatsAppKnapp.astro';
import type { Alternate } from '../i18n/alternates';
import { DEFAULT_LOCALE, type Locale } from '../i18n/locales';
import { navPath } from '../i18n/nav';
import { getServices, serviceSlugOf, servicePath } from '../i18n/services';
import { ui } from '../i18n/ui';
import { getFirma } from '../lib/firma';
import { telHref } from '../lib/telefon';

interface Props {
  locale: Locale;
  alternates: Alternate[];
  skjemaHref: string;
}

const { locale, alternates, skjemaHref } = Astro.props;
const t = ui[locale];
const firma = await getFirma();
const home = locale === DEFAULT_LOCALE ? '/' : `/${locale}/`;
const tjenester = (await getServices(locale)).map((e) => ({
  href: servicePath(locale, serviceSlugOf(e)),
  label: e.data.kundeTittel,
}));
const items = [
  { href: navPath(locale, 'tjenester'), label: t.nav.tjenester },
  { href: navPath(locale, 'priser'), label: t.nav.priser },
  { href: navPath(locale, 'omrader'), label: t.nav.omrader },
  { href: navPath(locale, 'om'), label: t.nav.om },
  { href: navPath(locale, 'kontakt'), label: t.nav.kontakt },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header-inner container">
    <a class="logo" href={home} aria-label={firma.navn}>
      <picture>
        <source media="(max-width: 719px)" srcset="/logo/kobber-og-kran-b.svg" />
        <img src="/logo/kobber-og-kran-a.svg" alt="" />
      </picture>
    </a>

    <button
      class="meny-knapp"
      type="button"
      aria-expanded="false"
      aria-controls="hovedmeny"
      data-apne={t.meny}
      data-lukk={t.lukk}
    >
      <span class="meny-knapp-tekst">{t.meny}</span>
    </button>

    <nav id="hovedmeny" class="hovedmeny" aria-label={t.hovedmeny}>
      <ul>
        {
          items.map((item) => (
            <li class={item.href === navPath(locale, 'tjenester') ? 'har-undermeny' : undefined}>
              <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
                {item.label}
              </a>
              {item.href === navPath(locale, 'tjenester') && (
                <>
                  <button
                    class="undermeny-knapp"
                    type="button"
                    aria-expanded="false"
                    aria-controls="undermeny-tjenester"
                    aria-label={t.visUndermeny}
                  >
                    <span aria-hidden="true">▾</span>
                  </button>
                  <ul id="undermeny-tjenester" class="undermeny">
                    {tjenester.map((s) => (
                      <li>
                        <a href={s.href} aria-current={current === s.href ? 'page' : undefined}>
                          {s.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-knapper">
      <a class="knapp" href={telHref(firma.telefon.verdi)}><svg class="ikon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11 11 0 0 0 3.5.55 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.2.2 2.4.55 3.5a1 1 0 0 1-.25 1z"/></svg><span class="etikett">{t.ring}</span></a>
      <WhatsAppKnapp class="knapp knapp-omriss" locale={locale}><svg class="ikon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M4 3h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H8l-4 4V4a1 1 0 0 1 1-1z"/></svg><span class="etikett">{t.whatsapp}</span></WhatsAppKnapp>
      <a class="knapp knapp-brun header-skjema" href={skjemaHref}>{t.skjemaKnapp}</a>
    </div>

    <div class="sprak">
      <LanguageSwitcher locale={locale} alternates={alternates} />
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var knapp = document.querySelector('.meny-knapp');
    var meny = document.getElementById('hovedmeny');
    if (!knapp || !meny) return;
    document.documentElement.classList.add('js');
    var tekst = knapp.querySelector('.meny-knapp-tekst');
    function sett(apen) {
      knapp.setAttribute('aria-expanded', apen ? 'true' : 'false');
      meny.classList.toggle('apen', apen);
      tekst.textContent = apen ? knapp.getAttribute('data-lukk') : knapp.getAttribute('data-apne');
    }
    knapp.addEventListener('click', function () {
      sett(knapp.getAttribute('aria-expanded') !== 'true');
    });
    var underKnapp = document.querySelector('.undermeny-knapp');
    var under = document.getElementById('undermeny-tjenester');
    function settUnder(apen) {
      underKnapp.setAttribute('aria-expanded', apen ? 'true' : 'false');
      under.classList.toggle('apen', apen);
    }
    if (underKnapp && under) {
      underKnapp.addEventListener('click', function () {
        settUnder(underKnapp.getAttribute('aria-expanded') !== 'true');
      });
      document.addEventListener('click', function (e) {
        if (!e.target.closest('.har-undermeny')) settUnder(false);
      });
    }
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && underKnapp && underKnapp.getAttribute('aria-expanded') === 'true') {
        settUnder(false);
        underKnapp.focus();
        return;
      }
      if (e.key === 'Escape' && knapp.getAttribute('aria-expanded') === 'true') {
        sett(false);
        knapp.focus();
      }
    });
  })();
</script>

<style>
  /* Visual order equals DOM order: logo, menu button, nav, buttons, language. */
  .site-header {
    position: relative;
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding-block: var(--space-2);
  }

  .logo {
    display: block;
    margin-right: auto;
  }

  .logo img {
    display: block;
    height: 3.5rem; /* set A: 166 px wide, above the 160 px minimum */
    width: auto;
  }

  .hovedmeny {
    flex-basis: 100%;
  }

  .hovedmeny ul {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hovedmeny a {
    display: block;
    padding: 0.75rem 0.25rem;
    color: var(--color-brown);
    font-weight: 600;
    text-decoration: none;
  }

  .hovedmeny a:hover,
  .hovedmeny a[aria-current='page'] {
    color: var(--color-orange-dark);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .meny-knapp {
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 2px solid var(--color-brown);
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--color-brown);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .header-knapper {
    display: none;
    gap: var(--space-2);
  }

  .header-knapper :global(.knapp) {
    white-space: nowrap;
  }

  .header-knapper :global(.ikon) {
    display: none;
  }

  /* Between 1000 and 1599px the buttons are compact: Ring and WhatsApp are icons with visually hidden labels. */
  @media (min-width: 1000px) and (max-width: 1599px) {
    .header-knapper {
      gap: var(--space-1);
    }

    .header-knapper :global(.knapp) {
      padding-inline: 0.6rem;
      font-size: 0.8125rem;
    }

    .header-knapper :global(.ikon) {
      display: block;
    }

    .header-knapper :global(.knapp:not(.header-skjema) .etikett) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .header-skjema {
      white-space: normal !important;
      line-height: 1.1;
      max-width: 8.5rem;
      text-align: center;
    }
  }

  /* With JavaScript the mobile menu is a dropdown under the header; without it the menu is a visible row. */
  :global(html.js) .hovedmeny {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 40;
    padding-inline: var(--space-3);
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-border-strong);
  }

  :global(html.js) .hovedmeny:not(.apen) {
    display: none;
  }

  /* Submenu. Without JavaScript it is a plain list of links (always visible on mobile, on hover/focus on desktop). */
  .undermeny-knapp {
    display: none;
  }

  .undermeny {
    margin-left: var(--space-3);
  }

  .undermeny a {
    font-weight: 400;
  }

  .undermeny-knapp span {
    display: inline-block;
    transition: transform 0.15s;
  }

  .undermeny-knapp[aria-expanded='true'] span {
    transform: rotate(180deg);
  }

  :global(html.js) .undermeny-knapp {
    display: inline-block;
    min-width: 2.75rem;
    min-height: 2.75rem;
    border: 0;
    background: transparent;
    color: var(--color-brown);
    font: inherit;
    cursor: pointer;
  }

  :global(html.js) .har-undermeny {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  :global(html.js) .har-undermeny > a {
    flex: 1;
  }

  :global(html.js) .undermeny {
    flex-basis: 100%;
  }

  :global(html.js) .undermeny:not(.apen) {
    display: none;
  }

  @media (max-width: 719px) {
    .logo img {
      height: 2.25rem; /* set B: 191 px wide, above the 140 px minimum */
    }
  }

  @media (min-width: 1000px) {
    .meny-knapp {
      display: none;
    }

    .site-header-inner {
      flex-wrap: nowrap;
      gap: var(--space-2);
    }

    .hovedmeny,
    :global(html.js) .hovedmeny,
    :global(html.js) .hovedmeny:not(.apen) {
      display: block;
      position: static;
      flex-basis: auto;
      padding: 0;
      background: none;
      border: 0;
    }

    .hovedmeny ul {
      flex-direction: row;
      gap: var(--space-2);
    }

    .hovedmeny a {
      white-space: nowrap;
      padding-inline: 0.4rem;
    }

    .header-knapper {
      display: flex;
    }

    .har-undermeny,
    :global(html.js) .har-undermeny {
      position: relative;
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
    }

    .hovedmeny .undermeny,
    :global(html.js) .hovedmeny .undermeny {
      position: absolute;
      top: 100%;
      left: 0;
      z-index: 50;
      min-width: 16rem;
      margin: 0;
      padding: var(--space-1) var(--space-2);
      background: var(--color-cream);
      border: 1px solid var(--color-border-strong);
      display: none;
      flex-direction: column;
      gap: 0;
    }

    /* No JavaScript: open on hover or keyboard focus. */
    .har-undermeny:hover .undermeny,
    .har-undermeny:focus-within .undermeny,
    :global(html.js) .hovedmeny .undermeny.apen {
      display: flex;
    }

    :global(html.js) .har-undermeny:hover .undermeny:not(.apen),
    :global(html.js) .har-undermeny:focus-within .undermeny:not(.apen) {
      display: none;
    }
  }

  @media (min-width: 1200px) {
    .site-header-inner {
      gap: var(--space-3);
    }

    .hovedmeny ul {
      gap: var(--space-3);
    }

    .hovedmeny a {
      padding-inline: 0.25rem;
    }
  }
</style>
