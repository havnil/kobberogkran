---
import type { Tekster } from '../lib/innhold';
import type { Firma } from '../lib/firma';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/locales';
import { telHref } from '../lib/telefon';

interface Props {
  locale: Locale;
  hero: Tekster['forside']['hero'];
  firma: Firma;
}

const { locale, hero, firma } = Astro.props;
const t = ui[locale];
---

<section class="hero" aria-labelledby="hero-tittel">
  <div class="hero-tekst">
    <p class="eyebrow">{hero.stedslinje}</p>
    <h1 id="hero-tittel">{hero.tittel}</h1>
    <p class="ingress">{hero.ingress}</p>
    <div class="hero-knapper">
      <a class="knapp" href={telHref(firma.telefon.verdi)}>{t.ring}</a>
      <a class="knapp knapp-brun" href="#skjema">{t.skjemaKnapp}</a>
    </div>
  </div>
  <ul class="faktaboks">
    {hero.lover.map((lofte) => <li>{lofte}</li>)}
  </ul>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-4) var(--space-3);
  }
  h1 {
    font-size: clamp(2rem, 7vw, 3.5rem);
    margin: 0 0 var(--space-3);
  }
  .ingress {
    font-size: 1.25rem;
    max-width: 38rem;
    margin: 0 0 var(--space-3);
  }
  .hero-knapper {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .faktaboks {
    list-style: none;
    margin: 0;
    padding: var(--space-3);
    display: grid;
    gap: var(--space-3);
    background: var(--color-brown);
    color: var(--color-cream);
    border-radius: var(--radius-card);
    align-content: center;
  }
  .faktaboks li {
    padding-left: 2rem;
    position: relative;
    font-weight: 600;
  }
  .faktaboks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.2em;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--color-orange);
  }
  @media (min-width: 1000px) {
    .hero {
      grid-template-columns: 1.4fr 1fr;
      align-items: center;
      padding-block: var(--space-5) var(--space-4);
    }
  }
</style>
