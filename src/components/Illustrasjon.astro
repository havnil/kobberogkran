---
// A drawn illustration or photo. Always decorative (`alt=""`): agents do not write alt text.
// A placeholder keeps `data-plassholder` (counted by the launch gate) and shows a small tag.
import type { Locale } from '../i18n/locales';
import { ui } from '../i18n/ui';

interface Props {
  src: string;
  width: number;
  height: number;
  locale: Locale;
  plassholder?: boolean;
  /** `eager` for images above the fold. */
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { src, width, height, locale, plassholder = false, loading = 'lazy', class: klasse } = Astro.props;
const merke = plassholder ? { 'data-plassholder': '' } : {};
---

<div class:list={['illustrasjon', klasse]} {...merke}>
  <img src={src} alt="" width={width} height={height} loading={loading} decoding="async" />
  {plassholder && <span class="illustrasjon-merke" aria-hidden="true">{ui[locale].illustrasjonMerke}</span>}
</div>

<style>
  .illustrasjon {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-cream);
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Discreet tag: brown text on translucent cream (well above 4.5:1 over any part of the drawings). */
  .illustrasjon-merke {
    position: absolute;
    left: var(--space-2);
    bottom: var(--space-2);
    padding: 0.15em 0.6em;
    border-radius: var(--radius-button);
    background: rgb(247 242 236 / 0.92);
    color: var(--color-brown);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.5;
  }
</style>
