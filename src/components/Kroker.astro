---
// The hook row on the front page: two cards side by side (stacked on small screens). «Tanksjekk» lets the
// customer check the water heater's age; the fixed price on replacing it is revealed with the answer.
// «Lekkasjesikker hytte» is the cabin offer: a short hook, three points, the fixed price on the work and a
// link to its page. Prices come from `firma`.
import TankMaaler from './TankMaaler.astro';
import Tall from './Tall.astro';
import type { Tekster } from '../lib/innhold';
import type { Firma } from '../lib/firma';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  tank: Tekster['forside']['tanksjekk'];
  hytte: Tekster['forside']['hyttesikring'];
  priser: Firma['priser'];
  tankHref: string;
  /** The «Lekkasjesikker hytte» page. Without it the cabin card is left out. */
  hytteHref?: string;
}

const { locale, tank, hytte, priser, tankHref, hytteHref } = Astro.props;
---

<section class="seksjon kroker-seksjon" aria-label={`${tank.eyebrow} · ${hytte.eyebrow}`}>
  <div class:list={['ramme', 'kroker', { enkel: !hytteHref }]}>
    <article class="krok" id="tanksjekk" aria-labelledby="tanksjekk-tittel">
      <p class="eyebrow">{tank.eyebrow}</p>
      <h2 id="tanksjekk-tittel" class="krok-tittel skra">{tank.tittel}</h2>
      <p class="krok-ingress">{tank.ingress}</p>
      <TankMaaler locale={locale} tekst={tank} tankHref={tankHref} pris={priser.varmtvannstankArbeid} id="tanksjekk" kompakt />
    </article>

    {
      hytteHref && (
        <article class="krok krok-hytte" id="hyttesikring" aria-labelledby="hyttesikring-tittel">
          <p class="eyebrow">{hytte.eyebrow}</p>
          <h2 id="hyttesikring-tittel" class="krok-tittel skra">{hytte.tittel}</h2>
          <p class="krok-ingress">{hytte.ingress}</p>
          <ul class="krok-punkter">
            {hytte.punkter.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
          <div class="krok-bunn">
            <p class="krok-pris">
              <span class="krok-pris-etikett">{hytte.prisEtikett}</span>
              <Tall verdi={priser.hyttesikringArbeid} enhet="kr" locale={locale} pris class="krok-pris-tall" />
            </p>
            <p class="krok-note">{hytte.prisNote}</p>
            <a class="knapp knapp-brun" href={hytteHref}>{hytte.knapp}</a>
          </div>
        </article>
      )
    }
  </div>
</section>

<style>
  .kroker {
    display: grid;
    gap: var(--space-4);
  }

  .krok {
    display: flex;
    flex-direction: column;
    container-type: inline-size;
    padding: 2rem var(--space-3);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-orange);
    box-shadow: 0 30px 60px -40px rgb(74 36 18 / 0.5);
  }

  .krok-hytte {
    border-top-color: var(--color-brown);
  }

  .krok-tittel {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.625rem, 3vw, 2.25rem);
    line-height: 1.05;
    text-wrap: balance;
  }

  .krok-ingress {
    max-width: 38rem;
    margin: 0 0 var(--space-4);
    color: var(--color-muted);
  }

  .krok-punkter {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
  }

  .krok-punkter li {
    position: relative;
    margin-bottom: 0.6rem;
    padding-left: 1.75rem;
  }

  /* The same orange drop as the article bullets. */
  .krok-punkter li::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 0.45em;
    width: 0.65rem;
    height: 0.85rem;
    background: var(--color-orange);
    clip-path: path('M5.2 0C5.2 0 0 6.2 0 9.6a5.2 5.2 0 0 0 10.4 0C10.4 6.2 5.2 0 5.2 0z');
  }

  /* Price, note and button sit at the bottom of the card, level with the tank card's bottom edge. */
  .krok-bunn {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .krok-pris {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0;
  }

  .krok-pris-etikett {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .krok-pris :global(.krok-pris-tall) {
    font-size: 2rem;
    line-height: 1.1;
  }

  .krok-note {
    margin: 0 0 0.5rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .krok-bunn .knapp {
    margin-left: 0.4rem;
  }

  @media (min-width: 720px) {
    .krok {
      padding: 2.5rem;
    }
  }

  @media (min-width: 1000px) {
    .kroker:not(.enkel) {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: stretch;
    }
  }
</style>
