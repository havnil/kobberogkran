---
import type { Tekster } from '../lib/innhold';
import type { Firma } from '../lib/firma';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/locales';
import { telHref } from '../lib/telefon';

interface Props {
  locale: Locale;
  tekst: Tekster['lekkerNaa'];
  firma: Firma;
}

const { locale, tekst, firma } = Astro.props;
const t = ui[locale];
---

<section class="lekker-naa" id="lekker-naa" aria-labelledby="lekker-naa-tittel">
  <h2 id="lekker-naa-tittel">{tekst.tittel}</h2>
  <ol>
    {tekst.punkter.map((punkt) => <li>{punkt}</li>)}
  </ol>
  <p class="ingen-dognvakt">{tekst.ingenDognvakt}</p>
  <a class="knapp" href={telHref(firma.telefon.verdi)}>{t.ring}</a>
</section>

<style>
  .lekker-naa {
    background: var(--color-brown);
    color: var(--color-cream);
    border-radius: var(--radius-card);
    padding: var(--space-4) var(--space-3);
    margin-block: var(--space-5);
  }
  h2 {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
  }
  ol {
    margin: 0 0 var(--space-3);
    padding-left: 1.5rem;
    display: grid;
    gap: var(--space-2);
  }
  ol li::marker {
    color: var(--color-orange-light);
    font-weight: 800;
  }
  .ingen-dognvakt {
    margin: 0 0 var(--space-3);
    max-width: 40rem;
  }
  @media (min-width: 720px) {
    .lekker-naa {
      padding: var(--space-4);
    }
  }
</style>
