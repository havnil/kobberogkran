---
import Illustrasjon from './Illustrasjon.astro';
import type { Tekster } from '../lib/innhold';
import type { Firma } from '../lib/firma';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  tekst: Pick<Tekster['forside']['omrader'], 'tittel'>;
  omrade: Firma['omrade'];
}

const { locale, tekst, omrade } = Astro.props;
---

<section class="seksjon omrader" aria-labelledby="omrader-tittel">
  <div class="tekst">
    <h2 id="omrader-tittel">{tekst.tittel}</h2>
    <ul>
      {omrade.steder.map((sted) => <li>{sted}</li>)}
    </ul>
  </div>
  <Illustrasjon class="kart" src="/images/uploads/illustrasjon-omrade.svg" width={1200} height={900} locale={locale} plassholder />
</section>

<style>
  .omrader {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }
  h2 {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  li {
    padding: 0.35rem 1rem;
    border-radius: var(--radius-button);
    background: var(--color-sand);
    font-weight: 600;
  }
  li:first-child {
    background: var(--color-orange);
    color: var(--color-on-orange);
  }
  .omrader :global(.kart) {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-border);
  }
  @media (min-width: 900px) {
    .omrader {
      grid-template-columns: 1fr 1.3fr;
      gap: var(--space-5);
    }
  }
</style>
