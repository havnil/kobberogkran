---
// The request form section (`#skjema`) on the front page, the service pages and the contact page: big title,
// intro and the phone number on the left, the form in a white panel on the right.
// `tjeneste` is the translationKey of the service to preselect; empty where no service is implied.
import LekkerNaa from './LekkerNaa.astro';
import Plassholder from './Plassholder.astro';
import Skjema from './Skjema.astro';
import type { Locale } from '../i18n/locales';
import type { Tekster } from '../lib/innhold';
import { getFirma } from '../lib/firma';
import { getTekster } from '../lib/tekster';
import { telHref } from '../lib/telefon';

interface Props {
  locale: Locale;
  tekst: Tekster['forside']['skjema'];
  eyebrow?: string;
  tjeneste?: string;
  /** Show «Lekker det nå?» under the phone number (front page; the menu links to `#lekker-naa`). */
  lekker?: boolean;
}

const { locale, tekst, eyebrow, tjeneste = '', lekker = false } = Astro.props;
const [firma, tekster] = await Promise.all([getFirma(), getTekster(locale)]);
---

<section class="seksjon skjemaseksjon" id="skjema" data-tjeneste={tjeneste} aria-labelledby="skjema-tittel">
  <div class="ramme ss">
    <div class="ss-venstre">
      <p class="eyebrow">{eyebrow ?? tekst.eyebrow}</p>
      <h2 id="skjema-tittel" class="display">{tekst.tittel}</h2>
      <p class="ss-merknad">{tekst.merknad}</p>
      <p class="ss-ring">{tekst.ringDirekte}</p>
      <p class="ss-nummer"><a href={telHref(firma.telefon.verdi)}><Plassholder verdi={firma.telefon} locale={locale} /></a></p>
      <p class="ss-adresse">
        {firma.epost.plassholder ? <Plassholder verdi={firma.epost} locale={locale} /> : <a href={`mailto:${firma.epost.verdi}`}>{firma.epost.verdi}</a>}
        <br />
        <Plassholder verdi={firma.adresse} locale={locale} />
      </p>
      {lekker && <LekkerNaa locale={locale} tekst={tekster.lekkerNaa} firma={firma} />}
    </div>
    <div class="ss-panel">
      <Skjema locale={locale} tjeneste={tjeneste} />
    </div>
  </div>
</section>

<style>
  .ss {
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }

  h2.display {
    margin-bottom: var(--space-3);
    font-size: clamp(1.9rem, 8vw, 3.75rem);
  }

  .ss-merknad {
    max-width: 30rem;
    margin: 0 0 var(--space-4);
    color: var(--color-muted);
  }

  .ss-ring {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
  }

  .ss-nummer {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 800;
    font-style: italic;
    line-height: 1.15;
  }

  .ss-nummer a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .ss-nummer a:hover {
    text-decoration: underline;
  }

  .ss-adresse {
    margin: 0 0 var(--space-4);
    color: var(--color-muted);
  }

  .ss-panel {
    min-width: 0;
    padding: 2rem var(--space-3);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-orange);
    box-shadow: 0 30px 60px -40px rgb(74 36 18 / 0.5);
  }

  @media (min-width: 720px) {
    .ss-panel {
      padding: 2.5rem;
    }
  }

  @media (min-width: 1000px) {
    .ss {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 4.5rem;
    }
  }
</style>
