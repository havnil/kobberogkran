---
import type { Tekster } from '../lib/innhold';

interface Props {
  tekst: Tekster['forside']['steg'];
}

const { tekst } = Astro.props;
// One drawn icon per step (send a request, the call back, job done). Steps beyond three get none.
const ANTALL_IKONER = 3;
---

<section class="seksjon" aria-labelledby="steg-tittel">
  <h2 id="steg-tittel">{tekst.tittel}</h2>
  <ol>
    {
      tekst.steg.map((steg, i) => (
        <li>
          <div class="topp">
            {i < ANTALL_IKONER && <img class="ikon" src={`/images/uploads/ikon-steg-${i + 1}.svg`} alt="" width="200" height="200" loading="lazy" decoding="async" />}
            <span class="nummer" aria-hidden="true">{i + 1}</span>
          </div>
          <h3>{steg.tittel}</h3>
          <p>{steg.tekst}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  h2 {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  li {
    position: relative;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: var(--space-3);
  }
  .topp {
    position: relative;
    width: 5.5rem;
    margin-bottom: var(--space-3);
  }
  .ikon {
    display: block;
    width: 5.5rem;
    height: 5.5rem;
  }
  .nummer {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-orange);
    color: var(--color-on-orange);
    font-weight: 800;
  }
  .ikon + .nummer {
    position: absolute;
    right: -0.75rem;
    bottom: -0.25rem;
    box-shadow: 0 0 0 3px var(--color-white);
  }
  h3 {
    margin: 0 0 var(--space-1);
    font-size: 1.25rem;
  }
  p {
    margin: 0;
  }
  @media (min-width: 720px) {
    ol {
      grid-template-columns: repeat(3, 1fr);
    }
    /* A dashed copper line joins the steps. */
    li:not(:last-child)::after {
      content: '';
      position: absolute;
      top: calc(var(--space-3) + 2.75rem);
      left: calc(100% + 1px);
      width: var(--space-3);
      border-top: 3px dashed var(--color-border-strong);
    }
  }
</style>
