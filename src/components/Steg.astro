---
// «Slik bestiller du»: three panels with coloured top lines (orange, copper, brown).
import type { Tekster } from '../lib/innhold';

interface Props {
  tekst: Tekster['forside']['steg'];
}

const { tekst } = Astro.props;
---

<section class="seksjon" aria-labelledby="steg-tittel">
  <div class="ramme">
    <div class="hode">
      <div>
        <p class="eyebrow">{tekst.eyebrow}</p>
        <h2 id="steg-tittel" class="display">{tekst.tittel}</h2>
      </div>
      <p class="hode-ingress">{tekst.ingress}</p>
    </div>
    <ol class="steg">
      {
        tekst.steg.map((steg, i) => (
          <li class="vis" data-steg={(i % 3) + 1}>
            <p class="steg-nr">
              {tekst.stegEtikett} {i + 1}
            </p>
            <h3 class="skra">{steg.tittel}</h3>
            <p>{steg.tekst}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steg {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  li {
    --linje: var(--color-orange);
    padding: 2.25rem 1.9rem 2.5rem;
    background: var(--color-white);
    border-top: 4px solid var(--linje);
    box-shadow:
      0 0 0 1px var(--color-border),
      0 20px 40px -36px rgb(74 36 18 / 0.5);
  }

  li[data-steg='2'] {
    --linje: var(--color-copper);
  }

  li[data-steg='3'] {
    --linje: var(--color-brown);
  }

  .steg-nr {
    margin: 0 0 1.25rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  li[data-steg='3'] .steg-nr {
    color: var(--color-brown);
  }

  h3 {
    margin: 0 0 0.75rem;
    font-size: 1.375rem;
  }

  li > p:last-child {
    margin: 0;
    color: var(--color-muted);
  }

  @media (min-width: 900px) {
    .steg {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
