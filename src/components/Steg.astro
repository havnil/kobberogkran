---
import type { Tekster } from '../lib/innhold';

interface Props {
  tekst: Tekster['forside']['steg'];
}

const { tekst } = Astro.props;
---

<section class="seksjon" aria-labelledby="steg-tittel">
  <h2 id="steg-tittel">{tekst.tittel}</h2>
  <ol>
    {
      tekst.steg.map((steg, i) => (
        <li>
          <span class="nummer" aria-hidden="true">{i + 1}</span>
          <h3>{steg.tittel}</h3>
          <p>{steg.tekst}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  h2 {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  li {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: var(--space-3);
  }
  .nummer {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: var(--space-2);
    border-radius: 50%;
    background: var(--color-orange);
    color: var(--color-brown);
    font-weight: 800;
  }
  h3 {
    margin: 0 0 var(--space-1);
    font-size: 1.25rem;
  }
  p {
    margin: 0;
  }
  @media (min-width: 720px) {
    ol {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
