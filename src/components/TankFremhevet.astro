---
// The featured product on the front page: fixed price for replacing a water heater. Illustration on top,
// the big price on the left, facts in monospace and two buttons on the right. «Send bilde av tanken»
// pre-selects the water-heater service in the form (`data-velg`); without JavaScript it opens the
// water-heater page at its form, where the service is already selected.
import Illustrasjon from './Illustrasjon.astro';
import Tall from './Tall.astro';
import type { Tekster } from '../lib/innhold';
import type { Firma } from '../lib/firma';
import type { Locale } from '../i18n/locales';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
  tekst: Tekster['forside']['varmtvann'];
  priser: Firma['priser'];
  tankHref: string;
}

const { locale, tekst, priser, tankHref } = Astro.props;
const arbeid = priser.varmtvannstankArbeid;
const tall = new Intl.NumberFormat(locale === 'nb' ? 'nb-NO' : 'en-GB').format(arbeid.verdi);
---

<section class="seksjon" id="varmtvannstank" aria-labelledby="tank-tittel">
  <div class="ramme">
    <article class="tank">
      <Illustrasjon class="tank-bilde" src="/images/uploads/illustrasjon-varmtvannstank.svg" width={1200} height={900} locale={locale} plassholder />
      <div class="tank-innhold">
        <div class="tank-pris">
          <p class="tank-tall" data-pris data-plassholder={arbeid.plassholder ? '' : undefined}>
            {tall}
            {arbeid.plassholder && <small class="plassholder-merke">{ui[locale].plassholderMerke}</small>}
          </p>
          <p class="tank-enhet">kr · {tekst.arbeidMerke}</p>
        </div>
        <div class="tank-tekst">
          <p class="eyebrow">{tekst.eyebrow}</p>
          <h2 id="tank-tittel" class="display">{tekst.tittel}</h2>
          <p class="ingress">{tekst.ingress}</p>
          <dl class="tank-fakta">
            <div>
              <dt>{tekst.faktaTotal}</dt>
              <dd><Tall verdi={priser.varmtvannstankTypiskTotal} enhet="kr" locale={locale} pris /></dd>
            </div>
            <div>
              <dt>{tekst.faktaTid}</dt>
              <dd class="tall">{tekst.faktaTidVerdi}</dd>
            </div>
            <div>
              <dt>{tekst.faktaDok}</dt>
              <dd class="tall">{tekst.faktaDokVerdi}</dd>
            </div>
          </dl>
          <div class="knapper">
            <a class="knapp" href={`${tankHref}#skjema`} data-velg="varmtvannstank">{tekst.knappBilde}</a>
            <a class="knapp knapp-flat" href={tankHref}>{tekst.knappLes}</a>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .tank {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-left: 5px solid var(--color-orange);
    box-shadow: 0 30px 60px -40px rgb(74 36 18 / 0.5);
  }

  .tank :global(.tank-bilde) {
    aspect-ratio: 16 / 5;
    border-radius: 0;
  }

  .tank :global(.tank-bilde img) {
    object-position: center 45%;
  }

  .tank-innhold {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-3);
  }

  .tank-tall {
    margin: 0;
    color: var(--color-orange); /* 3.1:1 on white: large text only */
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 14vw, 9rem);
    font-weight: 800;
    font-style: italic;
    line-height: 0.9;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .tank-tall .plassholder-merke {
    font-size: 0.75rem;
    vertical-align: top;
  }

  .tank-enhet {
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 800;
    font-style: italic;
    text-transform: uppercase;
  }

  h2.display {
    font-size: clamp(2rem, 4.2vw, 3.5rem);
    margin-bottom: var(--space-3);
  }

  .ingress {
    max-width: 36rem;
    margin: 0 0 var(--space-4);
    color: var(--color-muted);
  }

  .tank-fakta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) 2.5rem;
    margin: 0 0 var(--space-4);
  }

  dt {
    margin-bottom: 0.25rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    font-size: 1.375rem;
  }

  .knapper {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-inline: -0.4rem;
  }

  @media (min-width: 1000px) {
    .tank-innhold {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: center;
      gap: var(--space-5);
      padding: 4rem 4rem 4rem 3.5rem;
    }
  }
</style>
