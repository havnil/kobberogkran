---
// «Tanksjekk»: the customer types the year from the water heater's rating plate, and a half-circle gauge
// shows the tank's age against the age insurers tend to treat as old. Runs in the browser only, with no
// storage and no network. Without JavaScript the section shows the rule of thumb as text and the button
// opens the water-heater form. The button pre-selects the water-heater service in the form (`data-velg`).
import type { Tekster } from '../lib/innhold';

interface Props {
  tekst: Tekster['forside']['tanksjekk'];
  tankHref: string;
  /** `h2` on the front page; the water-heater page uses `h2` too, but can switch the id. */
  id?: string;
}

const { tekst, tankHref, id = 'tanksjekk' } = Astro.props;
const R = 105;
const CX = 130;
const CY = 140;
const punkt = (andel: number, r = R) => {
  const vinkel = Math.PI * (1 - andel);
  return { x: +(CX + r * Math.cos(vinkel)).toFixed(2), y: +(CY - r * Math.sin(vinkel)).toFixed(2) };
};
const lengde = +(Math.PI * R).toFixed(2);
const grense = tekst.grenseAr / tekst.maksAr;
const g = punkt(grense);
const gInne = punkt(grense, R - 18);
const gUte = punkt(grense, R + 16);
const bue = `M${CX - R} ${CY} A${R} ${R} 0 0 1 ${CX + R} ${CY}`;
const sone = `M${g.x} ${g.y} A${R} ${R} 0 0 1 ${CX + R} ${CY}`;
const klientTekster = {
  start: tekst.svarStart,
  ok: tekst.svarOk,
  snart: tekst.svarSnart,
  naa: tekst.svarNaa,
  ugyldig: tekst.svarUgyldig,
};
---

<section class="seksjon" id={id} aria-labelledby={`${id}-tittel`}>
  <div class="ramme">
    <div class="hode">
      <div>
        <p class="eyebrow">{tekst.eyebrow}</p>
        <h2 id={`${id}-tittel`} class="display">{tekst.tittel}</h2>
      </div>
      <p class="hode-ingress">{tekst.ingress}</p>
    </div>

    <div
      class="ts"
      data-tanksjekk
      data-snart={tekst.snartAr}
      data-grense={tekst.grenseAr}
      data-maks={tekst.maksAr}
      data-lengde={lengde}
      data-tekster={JSON.stringify(klientTekster)}
    >
      <div class="ts-inn">
        <div class="ts-felt" data-ts-felt hidden>
          <label class="ts-etikett" for={`${id}-ar`}>{tekst.arEtikett}</label>
          <input id={`${id}-ar`} class="ts-ar" type="text" inputmode="numeric" maxlength="4" autocomplete="off" placeholder="2008" aria-describedby={`${id}-hjelp`} />
          <p class="ts-hjelp" id={`${id}-hjelp`}>{tekst.arHjelp}</p>
        </div>
        <a class="knapp" href={`${tankHref}#skjema`} data-velg="varmtvannstank">{tekst.knapp}</a>
        <p class="ts-personvern">{tekst.personvern}</p>
      </div>

      <div class="ts-ut" data-status="tom">
        <svg class="ts-maaler" viewBox="0 0 260 160" aria-hidden="true">
          <path d={bue} fill="none" stroke="var(--color-sand)" stroke-width="22" />
          <path d={sone} fill="none" stroke="var(--color-copper-light)" stroke-opacity="0.45" stroke-width="22" />
          <path class="ts-verdi" d={bue} fill="none" stroke-width="22" stroke-dasharray={lengde} stroke-dashoffset={lengde} data-ts-bue />
          <path d={`M${gInne.x} ${gInne.y} L${gUte.x} ${gUte.y}`} stroke="var(--color-brown)" stroke-width="3" />
          <text x={gUte.x + 4} y={gUte.y - 4} class="ts-skala">{tekst.grenseAr}</text>
          <text x={CX - R} y={CY + 18} text-anchor="middle" class="ts-skala">0</text>
          <text x={CX + R} y={CY + 18} text-anchor="middle" class="ts-skala">{tekst.maksAr}+</text>
        </svg>
        <p class="ts-grense"><span aria-hidden="true">▲</span> {tekst.grenseAr} {tekst.alderEnhet} · {tekst.maalerGrense}</p>
        <p class="ts-tall" aria-hidden="true"><span data-ts-alder>–</span><span class="enhet">{tekst.alderEnhet}</span></p>
        <p class="ts-svar" role="status" data-ts-svar>{tekst.utenJs}</p>
        <p class="ts-forbehold">{tekst.forbehold}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { ELDSTE_AR, lesAr, maalerAndel, vurderTank } from '../lib/tanksjekk';

  for (const rot of document.querySelectorAll<HTMLElement>('[data-tanksjekk]')) {
    const felt = rot.querySelector<HTMLElement>('[data-ts-felt]')!;
    const input = felt.querySelector<HTMLInputElement>('input')!;
    const ut = rot.querySelector<HTMLElement>('.ts-ut')!;
    const bue = rot.querySelector<SVGPathElement>('[data-ts-bue]')!;
    const alderEl = rot.querySelector<HTMLElement>('[data-ts-alder]')!;
    const svar = rot.querySelector<HTMLElement>('[data-ts-svar]')!;
    const t = JSON.parse(rot.dataset.tekster ?? '{}') as Record<string, string>;
    const grenser = { snartAr: Number(rot.dataset.snart), grenseAr: Number(rot.dataset.grense) };
    const maks = Number(rot.dataset.maks);
    const lengde = Number(rot.dataset.lengde);
    const iAr = new Date().getFullYear();

    const vis = () => {
      const tekst = input.value.trim();
      if (tekst === '') {
        ut.dataset.status = 'tom';
        bue.style.strokeDashoffset = String(lengde);
        alderEl.textContent = '–';
        svar.textContent = t.start;
        input.removeAttribute('aria-invalid');
        return;
      }
      const v = vurderTank(lesAr(tekst), iAr, grenser);
      if (v.status === 'ugyldig') {
        ut.dataset.status = 'tom';
        bue.style.strokeDashoffset = String(lengde);
        alderEl.textContent = '–';
        // Only complain once four characters are typed.
        svar.textContent = tekst.length >= 4 ? t.ugyldig.replace('{fra}', String(ELDSTE_AR)).replace('{til}', String(iAr)) : t.start;
        if (tekst.length >= 4) input.setAttribute('aria-invalid', 'true');
        return;
      }
      input.removeAttribute('aria-invalid');
      ut.dataset.status = v.status;
      bue.style.strokeDashoffset = String(lengde * (1 - maalerAndel(v.alder, maks)));
      alderEl.textContent = String(v.alder);
      svar.textContent = t[v.status].replace('{alder}', String(v.alder));
    };

    felt.hidden = false;
    svar.textContent = t.start;
    input.addEventListener('input', vis);
  }
</script>

<style>
  .ts {
    display: grid;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    box-shadow: 0 30px 60px -40px rgb(74 36 18 / 0.5);
  }

  .ts-inn,
  .ts-ut {
    padding: 2.5rem var(--space-3);
  }

  .ts-inn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .ts-felt {
    width: 100%;
  }

  .ts-felt[hidden] {
    display: none;
  }

  .ts-etikett {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ts-ar {
    width: 100%;
    max-width: 22rem;
    padding: 0.25rem 0 0.5rem;
    border: 0;
    border-bottom: 2px solid var(--color-border-field);
    background: transparent;
    color: var(--color-brown);
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 800;
    font-style: italic;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .ts-ar::placeholder {
    color: var(--color-border-strong);
  }

  .ts-ar:focus-visible {
    outline: none;
    border-bottom-color: var(--color-orange);
    box-shadow: 0 2px 0 0 var(--color-orange);
  }

  .ts-ar[aria-invalid='true'] {
    border-bottom-color: var(--color-accent);
  }

  .ts-hjelp,
  .ts-personvern {
    margin: 0.5rem 0 0;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .ts-personvern {
    margin: 0;
  }

  .ts-inn .knapp {
    margin-top: var(--space-2);
  }

  .ts-ut {
    text-align: center;
  }

  .ts-maaler {
    display: block;
    width: 100%;
    max-width: 22rem;
    margin: 0 auto;
    overflow: visible;
  }

  .ts-verdi {
    stroke: var(--color-copper);
    transition:
      stroke-dashoffset 0.6s ease,
      stroke 0.3s;
  }

  [data-status='snart'] .ts-verdi {
    stroke: var(--color-orange);
  }

  [data-status='naa'] .ts-verdi {
    stroke: var(--color-orange-dark);
  }

  .ts-skala {
    fill: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
  }

  .ts-grense {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ts-tall {
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 800;
    font-style: italic;
    line-height: 1;
  }

  .ts-tall .enhet {
    margin-left: 0.3rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 1rem;
    font-style: normal;
  }

  .ts-svar {
    max-width: 30rem;
    margin: 1rem auto 0;
    min-height: 3.2em;
  }

  [data-status='naa'] .ts-svar {
    font-weight: 600;
  }

  .ts-forbehold {
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (min-width: 900px) {
    .ts {
      grid-template-columns: 1fr 1fr;
    }

    .ts-inn,
    .ts-ut {
      padding: 3rem;
    }

    .ts-inn {
      justify-content: center;
      border-bottom: 0;
      border-right: 1px solid var(--color-border);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ts-verdi {
      transition: none;
    }
  }
</style>
