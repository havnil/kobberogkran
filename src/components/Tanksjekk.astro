---
// «Tanksjekk» as a full section (the water-heater page): heading on the left, intro on the right and the
// calculator in a white panel below. The front page uses the calculator in a hook card instead (Kroker.astro).
import TankMaaler from './TankMaaler.astro';
import type { Tekster } from '../lib/innhold';
import type { Verdi } from '../lib/firma';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  tekst: Tekster['forside']['tanksjekk'];
  tankHref: string;
  /** Fixed price on the work, from `firma.priser.varmtvannstankArbeid`; revealed with the answer. */
  pris: Verdi<number>;
  id?: string;
}

const { locale, tekst, tankHref, pris, id = 'tanksjekk' } = Astro.props;
---

<section class="seksjon" id={id} aria-labelledby={`${id}-tittel`}>
  <div class="ramme">
    <div class="hode">
      <div>
        <p class="eyebrow">{tekst.eyebrow}</p>
        <h2 id={`${id}-tittel`} class="display">{tekst.tittel}</h2>
      </div>
      <p class="hode-ingress">{tekst.ingress}</p>
    </div>
    <TankMaaler locale={locale} tekst={tekst} tankHref={tankHref} pris={pris} id={id} />
  </div>
</section>
