---
import Illustrasjon from './Illustrasjon.astro';
import type { Tjeneste } from '../lib/innhold';
import type { Locale } from '../i18n/locales';
import { tjenesteBilde } from '../lib/illustrasjon';
import { aktivSesong } from '../lib/priser';

interface Props {
  href: string;
  tjeneste: Tjeneste;
  locale: Locale;
}

const { href, tjeneste, locale } = Astro.props;
// The cabin card swaps text with the season when the page is built.
const tekst = tjeneste.sesong ? tjeneste.sesong[aktivSesong(new Date())] : tjeneste.kort;
// A real image when there is one; otherwise the drawn illustration, marked as a placeholder.
const bilde = tjenesteBilde(tjeneste);
---

<li class="kort">
  <a href={href}>
    <Illustrasjon class="bilde" src={bilde.src} width={1200} height={900} locale={locale} plassholder={bilde.plassholder} />
    <span class="nummer" aria-hidden="true">{tjeneste.nummer}</span>
    <h3>{tjeneste.kundeTittel}</h3>
    <p class="fagord">{tjeneste.fagord}</p>
    <p class="tekst">{tekst}</p>
    <span class="mer" aria-hidden="true">→</span>
  </a>
</li>

<style>
  .kort {
    position: relative;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease,
      border-color 0.2s ease;
  }
  .kort:hover,
  .kort:focus-within {
    border-color: var(--color-border-strong);
    box-shadow: 0 14px 30px -18px rgb(74 36 18 / 0.45);
    transform: translateY(-2px);
  }
  a {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--color-text);
    text-decoration: none;
    padding-bottom: var(--space-3);
  }
  a:hover h3 {
    text-decoration: underline;
  }
  .kort :global(.bilde) {
    aspect-ratio: 3 / 2;
    border-radius: 0;
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .kort :global(.bilde img) {
    object-position: center 65%;
    transition: transform 0.4s ease;
  }
  .kort:hover :global(.bilde img) {
    transform: scale(1.03);
  }
  .nummer {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-orange);
    color: var(--color-on-orange);
    font-weight: 800;
    box-shadow: 0 0 0 3px var(--color-white);
  }
  h3 {
    margin: 0 var(--space-3) var(--space-1);
    font-size: 1.25rem;
  }
  .fagord {
    margin: 0 var(--space-3) var(--space-2);
    color: var(--color-muted);
    font-size: 0.9375rem;
  }
  .tekst {
    margin: 0 var(--space-3);
  }
  .mer {
    margin: auto var(--space-3) 0;
    padding-top: var(--space-2);
    color: var(--color-accent);
    font-weight: 800;
    font-size: 1.25rem;
    line-height: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .kort,
    .kort :global(.bilde img) {
      transition: none;
    }
    .kort:hover,
    .kort:focus-within {
      transform: none;
    }
    .kort:hover :global(.bilde img) {
      transform: none;
    }
  }
</style>
