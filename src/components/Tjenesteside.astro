---
// The service page template, as the reference: hero with breadcrumbs, big title and the fact card hanging
// from the pipe; article with the sticky side box; FAQ; related services as tiles; places as chips; and the
// request form with this service preselected. The water-heater page also gets the fixed price in detail
// and the tank check.
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Faktakort from './Faktakort.astro';
import Faq from './Faq.astro';
import Hero from './Hero.astro';
import Omrader from './Omrader.astro';
import Sideboks from './Sideboks.astro';
import Skjemaseksjon from './Skjemaseksjon.astro';
import Tanksjekk from './Tanksjekk.astro';
import TjenesteKort from './TjenesteKort.astro';
import VarmtvannstankBlokk from './VarmtvannstankBlokk.astro';
import type { Alternate } from '../i18n/alternates';
import type { Locale } from '../i18n/locales';
import { getServices, serviceSlugOf, servicePath, serviceTrail, type ServiceEntry } from '../i18n/services';
import { getFirma } from '../lib/firma';
import { tjenesteBilde } from '../lib/illustrasjon';
import { breadcrumbJsonLd, faqJsonLd, serviceJsonLd, SITE } from '../lib/jsonld';
import { aktivSesong } from '../lib/priser';
import { getTekster } from '../lib/tekster';

interface Props {
  locale: Locale;
  entry: ServiceEntry;
  alternates: Alternate[];
}

const { locale, entry, alternates } = Astro.props;
const tj = entry.data;
const [firma, tekster, alle, { Content }] = await Promise.all([getFirma(), getTekster(locale), getServices(locale), render(entry)]);
const s = tekster.sider;
const trail = serviceTrail(locale, entry);
const egenHref = servicePath(locale, serviceSlugOf(entry));
const url = `${SITE}${egenHref}`;
const jsonLd = [
  serviceJsonLd(tj, url),
  breadcrumbJsonLd(trail.map((ledd) => ({ name: ledd.name, url: `${SITE}${ledd.href ?? egenHref}` }))),
  faqJsonLd(tj.faq),
].filter((x): x is object => x !== null);
// A real image when there is one; otherwise the drawn illustration, marked as a placeholder.
const bilde = tjenesteBilde(tj);
const andre = alle.filter((e) => e.data.translationKey !== tj.translationKey);
const erBad = tj.translationKey === 'bad';
const erTank = tj.translationKey === 'varmtvannstank';
// The cabin card text changes with the season, like the front page badge.
const ingress = tj.sesong ? tj.sesong[aktivSesong(new Date())] : tj.kort;
// Pages that are not a service in the form (e.g. «Tett avløp») preselect the form service they belong to.
const skjemaTjeneste = tj.skjemaTjeneste ?? tj.translationKey;
// «Lekkasjesikker hytte» has a fixed price on the work: the first cell of the fact card, from `firma`.
const prisCelle =
  tj.translationKey === 'lekkasjesikker-hytte'
    ? [{ etikett: tekster.forside.hyttesikring.prisEtikett, verdi: firma.priser.hyttesikringArbeid, enhet: 'kr', pris: true, bred: true, under: tekster.forside.hyttesikring.prisNote }]
    : [];
const celler = [...prisCelle, ...tj.fakta.map((f, i) => ({ etikett: String(prisCelle.length + i + 1).padStart(2, '0'), tekst: f.tall, under: f.tekst, bred: true }))];
---

<BaseLayout locale={locale} title={tj.title} description={tj.kort} alternates={alternates} jsonLd={jsonLd} harSkjema fullBredde>
  <Hero
    locale={locale}
    firma={firma}
    trail={trail}
    eyebrow={s.tjeneste.stedslinje}
    tittel={tj.kundeTittel}
    ingress={ingress}
    skjemaHref="#skjema"
    bilde={{ src: bilde.src, width: 1200, height: 900, plassholder: bilde.plassholder }}
    kompakt
  >
    {
      celler.length > 0 && (
        <Faktakort
          slot="kort"
          locale={locale}
          venstre={s.tjeneste.faktaTittel}
          hoyre={tj.fagord}
          celler={celler}
          bunn={s.tjeneste.prisForStart}
        />
      )
    }
  </Hero>

  <div class="seksjon">
    <div class="ramme artikkel-rad">
      <article class="artikkel">
        <Content />
        {
          erBad && (
            <section aria-labelledby="bad-prosess-tittel">
              <h2 id="bad-prosess-tittel">{s.bad.prosessTittel}</h2>
              <ol>
                {s.bad.prosess.map((steg) => (
                  <li>
                    <strong>{steg.tittel}</strong>
                    <p>{steg.tekst}</p>
                  </li>
                ))}
              </ol>
              <h2>{s.bad.ansvarTittel}</h2>
              <p>{s.bad.ansvar}</p>
            </section>
          )
        }
      </article>
      <Sideboks locale={locale} firma={firma} tittel={s.tjeneste.sideboksTittel} tekst={s.tjeneste.sideboksTekst} tjeneste={tj.kundeTittel} utenPriser={erBad} />
    </div>
  </div>

  {erTank && <VarmtvannstankBlokk locale={locale} tekst={tekster.forside.varmtvann} priser={firma.priser} />}
  {erTank && <Tanksjekk locale={locale} tekst={tekster.forside.tanksjekk} tankHref={egenHref} pris={firma.priser.varmtvannstankArbeid} />}

  <Faq eyebrow={s.tjeneste.faqEyebrow} tittel={s.tjeneste.faqTittel} faq={tj.faq} />

  <section class="seksjon" aria-labelledby="andre-tittel">
    <div class="ramme">
      <div class="hode">
        <div>
          <p class="eyebrow">{s.tjeneste.andreEyebrow}</p>
          <h2 id="andre-tittel" class="display">{s.tjeneste.andreTittel}</h2>
        </div>
      </div>
      <ol class="ruter">
        {andre.map((e) => <TjenesteKort href={servicePath(locale, serviceSlugOf(e))} nummer={e.data.nummer} tittel={e.data.kundeTittel} tekst={e.data.kort} seMer={tekster.forside.tjenester.seMer} />)}
      </ol>
    </div>
  </section>

  <Omrader locale={locale} tekst={tekster.forside.omrader} tittel={s.tjeneste.omraderTittel} eyebrow={s.tjeneste.omraderEyebrow} omrade={firma.omrade} />

  <Skjemaseksjon locale={locale} tekst={tekster.forside.skjema} eyebrow={`${s.tjeneste.skjemaEyebrow} · ${tj.kundeTittel}`} tjeneste={skjemaTjeneste} />
</BaseLayout>
