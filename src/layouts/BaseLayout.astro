---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MobilBunnlinje from '../components/MobilBunnlinje.astro';
import RorSkinne from '../components/RorSkinne.astro';
import { getFirma } from '../lib/firma';
import { erLansering } from '../lib/lansering';
import { orgJsonLd } from '../lib/jsonld';
import type { Alternate } from '../i18n/alternates';
import { DEFAULT_LOCALE, type Locale } from '../i18n/locales';
import { navPath } from '../i18n/nav';
import { ui } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  alternates: Alternate[];
  /** Set on error pages: no canonical, no hreflang, not indexed. */
  noindex?: boolean;
  /** Structured data objects, each rendered as one JSON-LD script. The firm's own data is added on every indexed page. */
  jsonLd?: object[];
  /** Path or URL of the share image. Defaults to the brand share image. */
  ogImage?: string;
  /** The page has the request form section (`#skjema`): the form buttons jump there instead of to the contact page. */
  harSkjema?: boolean;
  /** The page lays out its own full-width sections (`.ramme` inside); otherwise `main` is a centred column. */
  fullBredde?: boolean;
}

const { locale, title, description, alternates, noindex = false, jsonLd = [], ogImage = '/og-image.png', harSkjema = false, fullBredde = false } = Astro.props;
const firma = await getFirma();
const alleJsonLd = noindex ? jsonLd : [orgJsonLd(firma, locale), ...jsonLd];
const skjemaHref = harSkjema ? '#skjema' : navPath(locale, 'kontakt');
const canonical = new URL(Astro.url.pathname, Astro.site);
const absolute = (href: string) => new URL(href, Astro.site).href;
// `<` is escaped so the JSON can never close the script element.
const jsonLdText = (data: object) => JSON.stringify(data).replace(/</g, '\\u003c');
const xDefault = alternates.find((alt) => alt.locale === DEFAULT_LOCALE);
// Every build that is not for launch says plainly that texts, prices and illustrations are drafts.
const utkast = !erLansering();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kobber og Kran" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={locale === 'nb' ? 'nb_NO' : 'en_GB'} />
    <meta property="og:image" content={absolute(ogImage)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/inter/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter/inter-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/rubik/rubik-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    {alleJsonLd.map((data) => <script type="application/ld+json" set:html={jsonLdText(data)} />)}
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical.href} />}
    {!noindex && alternates.map((alt) => <link rel="alternate" hreflang={alt.locale} href={absolute(alt.href)} />)}
    {!noindex && xDefault && <link rel="alternate" hreflang="x-default" href={absolute(xDefault.href)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{ui[locale].skipLink}</a>
    {
      utkast && (
        <p class="utkast-banner" role="note" data-plassholder>
          {ui[locale].utkastBanner}
        </p>
      )
    }
    <Header locale={locale} alternates={alternates} skjemaHref={skjemaHref} />
    <main id="main" class:list={[!fullBredde && 'container']}>
      <slot />
    </main>
    <Footer locale={locale} />
    <MobilBunnlinje locale={locale} skjemaHref={skjemaHref} />
    <RorSkinne locale={locale} href={skjemaHref} />
    <script>
      import '../scripts/whatsapp-kilde';
      import '../scripts/side';
    </script>
  </body>
</html>
