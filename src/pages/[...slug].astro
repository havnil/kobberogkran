---
import BaseLayout from '../layouts/BaseLayout.astro';
import Forside from '../components/Forside.astro';
import Side from '../components/Side.astro';
import { pagePaths, slugOf, type PageEntry } from '../i18n/pages';
import type { Alternate } from '../i18n/alternates';

export async function getStaticPaths() {
  return pagePaths('nb');
}

interface Props {
  entry: PageEntry;
  alternates: Alternate[];
}

const { entry, alternates } = Astro.props;
// The front page uses its own template; its copy comes from the `tekster` collection.
const erForside = slugOf(entry) === 'index';
---

<BaseLayout locale="nb" title={entry.data.title} description={entry.data.description} alternates={alternates} harSkjema={erForside || entry.data.translationKey === 'kontakt'}>
  {erForside ? <Forside locale="nb" /> : <Side locale="nb" entry={entry} />}
</BaseLayout>
