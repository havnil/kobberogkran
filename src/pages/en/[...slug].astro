---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Forside from '../../components/Forside.astro';
import { pagePaths, slugOf, type PageEntry } from '../../i18n/pages';
import type { Alternate } from '../../i18n/alternates';

export async function getStaticPaths() {
  return pagePaths('en');
}

interface Props {
  entry: PageEntry;
  alternates: Alternate[];
}

const { entry, alternates } = Astro.props;
// The front page uses its own template; its copy comes from the `tekster` collection.
const erForside = slugOf(entry) === 'index';
const { Content } = await render(entry);
---

<BaseLayout locale="en" title={entry.data.title} description={entry.data.description} alternates={alternates} harSkjema={erForside}>
  {
    erForside ? (
      <Forside locale="en" />
    ) : (
      <>
        <h1>{entry.data.title}</h1>
        <Content />
      </>
    )
  }
</BaseLayout>
