---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pagePaths, type PageEntry } from '../../i18n/pages';
import type { Alternate } from '../../i18n/alternates';

export async function getStaticPaths() {
  return pagePaths('en');
}

interface Props {
  entry: PageEntry;
  alternates: Alternate[];
}

const { entry, alternates } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout locale="en" title={entry.data.title} description={entry.data.description} alternates={alternates}>
  <h1>{entry.data.title}</h1>
  <Content />
</BaseLayout>
